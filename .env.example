# Public Backend API URL (used by the browser — set to your Railway Backend public domain + /api/v1)
# Example on Railway: https://collab47-backend-production.up.railway.app/api/v1
PUBLIC_API_BASE_URL=http://10.223.109.198:4000/api/v1

# Optional: Internal Railway private network Backend URL for faster SSR / Google OAuth server calls
# Example on Railway: http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}/api/v1
PRIVATE_API_BASE_URL=http://10.223.109.198:4000/api/v1

# SvelteKit @sveltejs/adapter-node Origin (auto-derived from RAILWAY_PUBLIC_DOMAIN on Railway if omitted)
# Example on Railway: https://collab47-frontend-production.up.railway.app
ORIGIN=

# Auth.js (@auth/sveltekit) Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://www.collab47.com/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_SECRET=replace-with-random-min-32-char-auth-secret-key
AUTH_TRUST_HOST=true

# Google AdSense Publisher ID (shown only for Free Membership; hidden for Premium)
PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-8499865824729612
